<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Security Assessment Report — {{ target|e }} | {{ company_name }}</title>
<style>
/* ============================================================
   SEA Corporate — Professional Security Report (v4.0)
   Design system: tokens, themes, enterprise layout, charts.
   Presentation only — no external fonts/CDNs, generation stays fast.
   ============================================================ */
:root{
  color-scheme: light;
  --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "SFMono-Regular", "JetBrains Mono", "Fira Code", Consolas, "Courier New", monospace;

  --bg:#EEF2F7; --surface:#FFFFFF; --surface-2:#F7F9FC; --surface-3:#F0F4FA;
  --border:#E4E9F1; --border-strong:#C9D3E0;
  --text:#0F172A; --text-2:#334155; --text-muted:#64748B; --text-faint:#94A3B8;

  --accent:#4F46E5; --accent-2:#0EA5E9; --accent-ink:#FFFFFF;
  --ok:#0E9F6E; --warn:#D97706; --err:#E5484D;

  --sev-critical:#E5484D; --sev-high:#F76B15; --sev-medium:#F5A623;
  --sev-low:#2E9E5B; --sev-warning:#D97706; --sev-info:#64748B; --sev-safe:#0E9F6E;

  --chart-track:rgba(100,116,139,.14);
  --shadow-sm:0 1px 2px rgba(15,23,42,.06), 0 1px 3px rgba(15,23,42,.05);
  --shadow-md:0 4px 12px rgba(15,23,42,.08), 0 2px 4px rgba(15,23,42,.05);
  --shadow-lg:0 18px 40px -12px rgba(15,23,42,.22);
  --r-sm:8px; --r-md:12px; --r-lg:18px; --r-xl:24px;
  --header-bg:radial-gradient(1200px 500px at 80% -20%, rgba(79,70,229,.55), transparent 60%),
              radial-gradient(900px 400px at 10% 110%, rgba(14,165,233,.35), transparent 55%),
              linear-gradient(160deg,#0B1220 0%,#101B31 55%,#0D1B2E 100%);
}
[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0B1220; --surface:#101A2E; --surface-2:#15233C; --surface-3:#1A2A47;
  --border:#1E2C49; --border-strong:#2B3D63;
  --text:#E6ECF7; --text-2:#C3CEDF; --text-muted:#8CA0BD; --text-faint:#5E7296;
  --shadow-sm:0 1px 2px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.3);
  --shadow-md:0 6px 18px rgba(0,0,0,.45), 0 2px 6px rgba(0,0,0,.35);
  --shadow-lg:0 20px 48px -14px rgba(0,0,0,.6);
  --chart-track:rgba(140,160,189,.16);
  --accent:#6366F1; --accent-2:#38BDF8;
  --header-bg:radial-gradient(1200px 500px at 80% -20%, rgba(99,102,241,.5), transparent 60%),
              radial-gradient(900px 400px at 10% 110%, rgba(56,189,248,.28), transparent 55%),
              linear-gradient(160deg,#060B16 0%,#0C1425 55%,#081322 100%);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --bg:#0B1220; --surface:#101A2E; --surface-2:#15233C; --surface-3:#1A2A47;
    --border:#1E2C49; --border-strong:#2B3D63;
    --text:#E6ECF7; --text-2:#C3CEDF; --text-muted:#8CA0BD; --text-faint:#5E7296;
    --shadow-sm:0 1px 2px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.3);
    --shadow-md:0 6px 18px rgba(0,0,0,.45), 0 2px 6px rgba(0,0,0,.35);
    --shadow-lg:0 20px 48px -14px rgba(0,0,0,.6);
    --chart-track:rgba(140,160,189,.16);
    --accent:#6366F1; --accent-2:#38BDF8;
    --header-bg:radial-gradient(1200px 500px at 80% -20%, rgba(99,102,241,.5), transparent 60%),
                radial-gradient(900px 400px at 10% 110%, rgba(56,189,248,.28), transparent 55%),
                linear-gradient(160deg,#060B16 0%,#0C1425 55%,#081322 100%);
  }
}
[data-theme="system"]{}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--font-sans);
  background:var(--bg);
  color:var(--text);
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
  font-size:14.5px;
}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
code,.mono{font-family:var(--font-mono)}
h1,h2,h3,h4{line-height:1.25;color:var(--text)}

/* ---------- shell ---------- */
.page{max-width:1180px;margin:0 auto;padding:22px 18px 60px}
.shell{display:grid;grid-template-columns:248px 1fr;gap:22px;align-items:start}
.main{min-width:0}
@media(max-width:960px){.shell{grid-template-columns:1fr}}

/* ---------- hero / cover ---------- */
.hero{
  background:var(--header-bg);
  color:#fff;border-radius:var(--r-xl);
  padding:34px 36px 30px;position:relative;overflow:hidden;
  box-shadow:var(--shadow-lg);margin-bottom:22px;
}
.hero::before{
  content:"";position:absolute;inset:0;opacity:.14;pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.35) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.35) 1px,transparent 1px);
  background-size:42px 42px;
}
.hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;position:relative;z-index:1}
.hero-brand{display:flex;align-items:center;gap:14px;min-width:0}
.hero-logo{max-height:56px;max-width:210px;border-radius:10px;background:rgba(255,255,255,.96);padding:6px 10px;object-fit:contain}
.hero-badge{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A9B7D8;font-weight:600}
.hero h1{color:#fff;font-size:30px;font-weight:750;letter-spacing:-.01em}
.hero .subtitle{color:#C7D3EC;font-size:15px;margin-top:2px}
.hero-actions{display:flex;gap:8px;flex:none}
.hbtn{
  display:inline-flex;align-items:center;gap:7px;cursor:pointer;border:none;
  background:rgba(255,255,255,.12);color:#fff;font-family:var(--font-sans);
  font-size:12.5px;font-weight:600;padding:8px 13px;border-radius:10px;
  border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);
  transition:background .15s ease,transform .1s ease;
}
.hbtn:hover{background:rgba(255,255,255,.22)}
.hbtn:active{transform:translateY(1px)}
.hbtn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.hero-meta{
  position:relative;z-index:1;margin-top:22px;display:grid;gap:10px;
  grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
}
.hm-item{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.13);border-radius:var(--r-md);padding:9px 13px}
.hm-item .hm-k{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:#9FB0D6;font-weight:600}
.hm-item .hm-v{font-size:13.5px;color:#fff;font-weight:600;margin-top:1px;word-break:break-word}
.hm-item .hm-v small{color:#B9C6E4;font-weight:500}
.hero-verdict{
  position:relative;z-index:1;margin-top:18px;display:flex;align-items:center;gap:12px;
  flex-wrap:wrap;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.16);
  border-radius:var(--r-md);padding:12px 16px;
}
.hv-dot{width:12px;height:12px;border-radius:50%;flex:none;box-shadow:0 0 0 4px rgba(255,255,255,.12)}
.hv-label{font-weight:700;font-size:15.5px;color:#fff}
.hv-desc{color:#CBD6EF;font-size:13px;flex:1;min-width:200px}

/* ---------- toc ---------- */
.toc{position:sticky;top:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px 14px;box-shadow:var(--shadow-sm)}
.toc-title{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);font-weight:700;margin-bottom:10px;padding:0 6px}
.toc a{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:8px;font-size:13px;color:var(--text-2);font-weight:500;transition:background .12s,color .12s}
.toc a:hover{background:var(--surface-2);color:var(--accent);text-decoration:none}
.toc a .toc-dot{width:8px;height:8px;border-radius:50%;flex:none}
.toc .toc-count{margin-left:auto;font-size:11px;color:var(--text-faint);background:var(--surface-3);padding:0 7px;border-radius:99px;font-weight:600}
@media(max-width:960px){
  .toc{position:static;order:-1;display:flex;flex-wrap:wrap;gap:4px;align-items:center}
  .toc-title{width:100%;margin-bottom:4px}
  .toc a{padding:4px 10px}
}

/* ---------- panels ---------- */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:22px 24px;margin-bottom:22px;box-shadow:var(--shadow-sm)}
.panel h2{
  font-size:17px;font-weight:700;letter-spacing:-.01em;margin-bottom:4px;
  display:flex;align-items:center;gap:10px;
}
.panel h2 .p-ic{width:30px;height:30px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:var(--surface-3);color:var(--accent);flex:none}
.panel h2 .p-ic svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.panel > .p-sub{color:var(--text-muted);font-size:13px;margin-bottom:16px}
.panel h3{font-size:14px;font-weight:700;margin:18px 0 8px}
.p-kicker{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);font-weight:700;margin-bottom:2px}

/* ---------- executive summary ---------- */
.executive-summary{border-radius:var(--r-lg);padding:4px 0;margin:0 0 6px}
.es-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.es-head h3{font-size:15px;font-weight:700;margin:0}
.es-badge{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:4px 12px;border-radius:99px}
.executive-summary .es-body{font-size:14px;line-height:1.7;color:var(--text-2)}
.exec-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-top:16px}
.em-item{background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-md);padding:9px 12px}
.em-label{display:block;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);font-weight:600}
.em-value{display:block;font-size:18px;font-weight:750;color:var(--text);margin-top:1px}
.executive-summary.critical-summary{background:color-mix(in srgb,var(--sev-critical) 8%,var(--surface));border-left:5px solid var(--sev-critical)}
.executive-summary.medium-summary{background:color-mix(in srgb,var(--sev-medium) 10%,var(--surface));border-left:5px solid var(--sev-medium)}
.executive-summary.safe-summary{background:color-mix(in srgb,var(--sev-safe) 9%,var(--surface));border-left:5px solid var(--sev-safe)}
.es-badge{background:var(--surface-3);color:var(--text-2);border:1px solid var(--border)}

/* ---------- kpi row ---------- */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.kpi{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:15px 16px 13px;box-shadow:var(--shadow-sm);overflow:hidden}
.kpi::before{content:"";position:absolute;inset:0 0 auto 0;height:3px}
.kpi .k-label{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--text-muted);font-weight:700}
.kpi .k-value{font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1.1;margin-top:3px;color:var(--text)}
.kpi .k-foot{font-size:11.5px;color:var(--text-muted);margin-top:2px}
.k-crit::before{background:var(--sev-critical)} .k-crit .k-value{color:var(--sev-critical)}
.k-high::before{background:var(--sev-high)} .k-high .k-value{color:var(--sev-high)}
.k-medium::before{background:var(--sev-medium)} .k-medium .k-value{color:var(--sev-medium)}
.k-low::before{background:var(--sev-low)} .k-low .k-value{color:var(--sev-low)}
.k-warning::before{background:var(--sev-warning)} .k-warning .k-value{color:var(--sev-warning)}
.k-info::before{background:var(--sev-info)} .k-info .k-value{color:var(--sev-info)}
.k-safe::before{background:var(--sev-safe)} .k-safe .k-value{color:var(--sev-safe)}
.k-accent::before{background:linear-gradient(90deg,var(--accent),var(--accent-2))}

/* ---------- dashboard charts row ---------- */
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media(max-width:760px){.dash-grid{grid-template-columns:1fr}}
.chart-card{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);padding:18px}
.chart-title{font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:14px}
.chart-title .c-kicker{font-size:10.5px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.1em}
.chart-body{display:flex;align-items:center;gap:22px;flex-wrap:wrap}

/* donut (conic) */
.donut{position:relative;width:150px;height:150px;border-radius:50%;flex:none;background:var(--chart-track)}
.donut-mask{
  position:absolute;inset:0;border-radius:50%;
  -webkit-mask:radial-gradient(farthest-side,transparent 66%,#000 67%);
  mask:radial-gradient(farthest-side,transparent 66%,#000 67%);
}
.donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.donut-center .d-num{font-size:28px;font-weight:800;letter-spacing:-.02em;line-height:1}
.donut-center .d-cap{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);font-weight:700;margin-top:2px}
.legend{display:grid;gap:7px;flex:1;min-width:180px}
.legend-row{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--text-2)}
.legend-row .l-swatch{width:11px;height:11px;border-radius:3.5px;flex:none}
.legend-row .l-name{font-weight:600;color:var(--text)}
.legend-row .l-val{margin-left:auto;font-weight:700;color:var(--text)}
.legend-row .l-pct{width:44px;text-align:right;color:var(--text-muted);font-weight:600}

/* ring gauge */
.gauge{position:relative;width:150px;height:150px;border-radius:50%;flex:none;background:var(--chart-track)}
.gauge-mask{position:absolute;inset:0;border-radius:50%;-webkit-mask:radial-gradient(farthest-side,transparent 70%,#000 71%);mask:radial-gradient(farthest-side,transparent 70%,#000 71%)}
.gauge-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.gauge-center .g-num{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1}
.gauge-center .g-cap{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);font-weight:700;margin-top:2px}
.g-band-ok{--gauge-color:var(--sev-safe)}
.g-band-warn{--gauge-color:var(--sev-medium)}
.g-band-err{--gauge-color:var(--sev-critical)}
.gauge-side{flex:1;min-width:180px}
.gauge-side .gs-row{display:flex;justify-content:space-between;font-size:12.5px;color:var(--text-2);padding:4px 0;border-bottom:1px dashed var(--border)}
.gauge-side .gs-row:last-child{border-bottom:none}
.gauge-side .gs-row b{color:var(--text)}

/* coverage bar */
.coverage-section{margin-top:6px}
.coverage-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px}
.coverage-head .title{font-weight:700;font-size:13.5px}
.coverage-head .percentage{font-weight:800;font-size:19px;color:var(--text)}
.coverage-track{height:10px;background:var(--surface-3);border-radius:99px;overflow:hidden;border:1px solid var(--border)}
.coverage-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width .8s ease}
.coverage-footer{display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--text-muted);margin-top:7px}

/* stacked severity bar */
.sev-stack{display:flex;height:14px;border-radius:8px;overflow:hidden;background:var(--surface-3);border:1px solid var(--border);margin:4px 0 10px}
.sev-stack div{height:100%}

/* ---------- severity cards ---------- */
.sev-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.sev-card{border-radius:var(--r-lg);padding:14px 16px;border:1px solid var(--border);background:var(--surface-2);position:relative;overflow:hidden;box-shadow:var(--shadow-sm)}
.sev-card::after{content:"";position:absolute;right:-18px;top:-18px;width:64px;height:64px;border-radius:50%;opacity:.12}
.sev-card .sc-count{font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1}
.sev-card .sc-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;margin-top:2px}
.sev-card .sc-note{font-size:11px;color:var(--text-muted);margin-top:2px}
.sc-critical{color:var(--sev-critical)} .sc-critical::after{background:var(--sev-critical)}
.sc-high{color:var(--sev-high)} .sc-high::after{background:var(--sev-high)}
.sc-medium{color:var(--sev-medium)} .sc-medium::after{background:var(--sev-medium)}
.sc-low{color:var(--sev-low)} .sc-low::after{background:var(--sev-low)}
.sc-warning{color:var(--sev-warning)} .sc-warning::after{background:var(--sev-warning)}
.sc-info{color:var(--sev-info)} .sc-info::after{background:var(--sev-info)}
.sc-safe{color:var(--sev-safe)} .sc-safe::after{background:var(--sev-safe)}
.sev-card .sc-count,.sev-card .sc-label{color:inherit}

/* ---------- risk meter ---------- */
.risk-meter{padding:4px 0}
.risk-score-row{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin:6px 0 12px}
.risk-score-big{text-align:left}
.risk-score-big .rs-num{font-size:46px;font-weight:800;letter-spacing:-.03em;line-height:1;color:var(--text)}
.risk-score-big .rs-sub{font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.1em}
.meter{position:relative}
.meter-track{height:16px;border-radius:99px;background:linear-gradient(90deg,var(--sev-safe),var(--sev-medium) 55%,var(--sev-critical));overflow:hidden;opacity:.9}
.meter-fill{position:absolute;top:0;left:0;height:16px;width:2px;background:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.75),0 1px 4px rgba(0,0,0,.5);border-radius:2px;transition:left .6s ease}
.meter-labels{display:flex;justify-content:space-between;color:var(--text-muted);font-size:11px;font-weight:600;margin-top:6px}
.risk-note{margin-top:14px;padding:12px 15px;background:var(--surface-2);border:1px solid var(--border);border-left:4px solid var(--accent);border-radius:var(--r-md);font-size:13px;color:var(--text-2)}

/* ---------- attack surface ---------- */
.attack-surface{padding:2px 0 6px}
.attack-surface h3,.finding-section h3{font-size:15px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:9px}
.attack-surface h3 .as-emoji,.finding-section h3 .as-emoji{display:none}
.as-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:11px;margin-bottom:8px}
.as-item{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:13px 10px;text-align:center;transition:transform .12s ease,box-shadow .12s ease}
.as-item:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
.as-item .as-icon{width:34px;height:34px;margin:0 auto 8px;border-radius:10px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;color:var(--accent)}
.as-item .as-icon svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.as-item .as-label{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);font-weight:700}
.as-item .as-value{font-size:19px;font-weight:800;color:var(--text);margin-top:1px}
.as-sub{margin:16px 0 10px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
.as-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}
.as-section{margin-bottom:12px}
.as-section h4{font-size:12.5px;font-weight:700;margin-bottom:7px;padding-bottom:5px;border-bottom:1px solid var(--border)}
.as-metric{display:flex;justify-content:space-between;padding:3px 0;font-size:12.5px}
.as-metric .as-label{color:var(--text-muted)}
.as-metric .as-value{font-weight:700;color:var(--text)}
.tech-item{display:inline-block;padding:3px 10px;margin:2px 3px 2px 0;background:var(--surface-3);border:1px solid var(--border);border-radius:99px;font-size:11.5px;color:var(--text-2)}

/* ---------- auth ---------- */
.auth-section{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);padding:20px 22px;margin-bottom:22px}
.auth-section h3{font-size:15px;font-weight:700;margin-bottom:14px}
.auth-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:9px;margin-bottom:14px}
.auth-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:9px 12px}
.auth-label{display:block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);font-weight:600}
.auth-value{display:block;font-size:14.5px;font-weight:700;color:var(--text);margin-top:1px}
.auth-coverage{background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-md);padding:11px 14px;margin:8px 0}
.auth-coverage-row{display:flex;gap:18px;font-size:12.5px;color:var(--text-2);flex-wrap:wrap}
.auth-coverage-bar{height:9px;background:var(--border);border-radius:99px;overflow:hidden;margin-top:9px}
.auth-coverage-fill{height:100%;background:linear-gradient(90deg,var(--sev-high),var(--sev-critical));border-radius:99px}
.auth-session,.auth-reason,.auth-area{font-size:12.5px;color:var(--text-2);margin:5px 0}
.auth-token-note{color:var(--text-muted)}

/* ---------- finding sections ---------- */
.report-section{scroll-margin-top:18px}
.finding-section{margin-bottom:20px}
.section-title{
  display:flex;align-items:center;gap:12px;padding:11px 16px;border-radius:var(--r-md);
  margin-bottom:13px;font-size:15.5px;font-weight:750;letter-spacing:-.01em;
  background:var(--surface-3);border:1px solid var(--border);border-left-width:5px;
}
.section-title .st-count{margin-left:auto;font-size:12px;font-weight:700;background:var(--surface);border:1px solid var(--border);border-radius:99px;padding:2px 11px;color:var(--text-2)}
.section-critical{border-left-color:var(--sev-critical);color:var(--sev-critical)}
.section-high{border-left-color:var(--sev-high);color:var(--sev-high)}
.section-medium{border-left-color:var(--sev-medium);color:var(--sev-medium)}
.section-low{border-left-color:var(--sev-low);color:var(--sev-low)}
.section-warning{border-left-color:var(--sev-warning);color:var(--sev-warning)}
.section-info{border-left-color:var(--sev-info);color:var(--sev-info)}
.section-safe{border-left-color:var(--sev-safe);color:var(--sev-safe)}
.section-title .st-label{color:var(--text)}

/* finding card */
.finding-card{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:18px 20px 16px;margin-bottom:14px;box-shadow:var(--shadow-sm);
  border-left:5px solid var(--border-strong);position:relative;
  transition:box-shadow .15s ease;
}
.finding-card:hover{box-shadow:var(--shadow-md)}
.finding-critical{border-left-color:var(--sev-critical)}
.finding-high{border-left-color:var(--sev-high)}
.finding-medium{border-left-color:var(--sev-medium)}
.finding-low{border-left-color:var(--sev-low)}
.finding-card .title{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:15.5px;font-weight:700;margin-bottom:12px}
.finding-card .title > span:first-child{flex:1;min-width:160px}
.finding-card .detail{margin:6px 0;color:var(--text-2);font-size:13.5px}
.finding-card .detail strong{color:var(--text)}
.finding-card .reason-box,.finding-card .recommend-box{
  background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:10px 13px;margin:8px 0;font-size:13px;color:var(--text-2)
}
.finding-card .recommend-box{border-left:4px solid var(--accent);background:color-mix(in srgb,var(--accent) 6%,var(--surface))}
.finding-card .recommend-box strong{color:var(--accent)}

/* badges */
.badge{display:inline-flex;align-items:center;gap:6px;padding:3px 11px;border-radius:99px;font-size:10.5px;font-weight:750;letter-spacing:.07em;text-transform:uppercase;color:#fff;background:var(--sev-info)}
.badge-critical{background:var(--sev-critical)} .badge-high{background:var(--sev-high)}
.badge-medium{background:var(--sev-medium);color:#3b2a00} .badge-low{background:var(--sev-low)}
.badge-safe{background:var(--sev-safe)} .badge-info{background:var(--sev-info)} .badge-warning{background:var(--sev-warning)}
.vbadge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:99px;font-size:10px;font-weight:750;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--border)}
.vbadge-verified{background:color-mix(in srgb,var(--sev-safe) 14%,var(--surface));color:var(--sev-safe);border-color:color-mix(in srgb,var(--sev-safe) 40%,var(--border))}
.vbadge-likely{background:color-mix(in srgb,var(--sev-medium) 16%,var(--surface));color:var(--sev-warning);border-color:color-mix(in srgb,var(--sev-medium) 45%,var(--border))}
.vbadge-possible{background:color-mix(in srgb,var(--sev-high) 15%,var(--surface));color:var(--sev-high);border-color:color-mix(in srgb,var(--sev-high) 45%,var(--border))}
.vbadge-manual{background:color-mix(in srgb,var(--sev-critical) 12%,var(--surface));color:var(--sev-critical);border-color:color-mix(in srgb,var(--sev-critical) 40%,var(--border))}
.vbadge-unverified{background:var(--surface-3);color:var(--text-muted);border-color:var(--border)}

/* timeline */
.timeline{display:flex;align-items:center;flex-wrap:wrap;gap:4px;margin:10px 0 12px;padding:7px 10px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md)}
.tl-step{padding:3px 9px;border-radius:7px;font-weight:650;font-size:10px;letter-spacing:.03em;white-space:nowrap}
.tl-discovery{background:color-mix(in srgb,var(--accent-2) 14%,var(--surface));color:var(--accent-2)}
.tl-scan{background:color-mix(in srgb,var(--accent) 14%,var(--surface));color:var(--accent)}
.tl-evidence{background:color-mix(in srgb,var(--sev-safe) 14%,var(--surface));color:var(--sev-safe)}
.tl-decision{background:color-mix(in srgb,var(--sev-warning) 14%,var(--surface));color:var(--sev-warning)}
.tl-risk{background:color-mix(in srgb,var(--sev-critical) 13%,var(--surface));color:var(--sev-critical)}
.tl-final{background:var(--text);color:var(--surface)}
.tl-arrow{color:var(--text-faint);font-weight:700;padding:0 2px}
.tl-arrow::before{content:"›"}

/* confidence breakdown */
.confidence-breakdown{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:10px 13px;margin:8px 0;font-size:12.5px}
.confidence-breakdown .factors{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.confidence-breakdown .factor{padding:2px 10px;border-radius:99px;font-size:10.5px;font-weight:700}
.confidence-breakdown .factor.positive{background:color-mix(in srgb,var(--sev-safe) 14%,var(--surface));color:var(--sev-safe)}
.confidence-breakdown .factor.negative{background:color-mix(in srgb,var(--sev-critical) 13%,var(--surface));color:var(--sev-critical)}
.confidence-breakdown .final{margin-top:4px;font-weight:750;color:var(--text)}
.confidence-breakdown .final span{color:var(--accent)}

/* evidence blocks */
.evidence-block{margin:6px 0}
.evidence-block .url-list{margin:6px 0 6px 18px;font-size:13px}
.evidence-block .url-list a{color:var(--accent)}
.evidence-block .url-list li{margin:2px 0}
details.evidence-block{border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden;background:var(--surface-2)}
details.evidence-block > summary{cursor:pointer;list-style:none;padding:9px 13px;font-weight:650;font-size:12.5px;display:flex;align-items:center;gap:8px}
details.evidence-block > summary::-webkit-details-marker{display:none}
details.evidence-block > summary .toggle-icon{margin-left:auto;transition:transform .18s ease}
details.evidence-block[open] > summary .toggle-icon{transform:rotate(180deg)}
details.evidence-block[open] > .http-detail,.evidence-block[open] > .http-detail{display:block}

/* http request/response blocks */
.http-block{margin:8px 0;border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden;background:var(--surface)}
.http-title{list-style:none;cursor:pointer;padding:9px 12px;background:var(--surface-2);display:flex;align-items:center;gap:10px;font-size:12.5px;font-weight:650;user-select:none}
.http-title::-webkit-details-marker{display:none}
.http-title:hover{background:var(--surface-3)}
.http-method{display:inline-block;padding:2px 9px;border-radius:6px;background:var(--accent);color:#fff;font-size:10px;font-weight:800;letter-spacing:.05em}
.http-status{display:inline-block;padding:2px 9px;border-radius:6px;background:var(--sev-safe);color:#fff;font-size:10px;font-weight:800}
.http-url{color:var(--text-2);font-size:11.5px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.http-len{color:var(--text-muted);font-size:10.5px}
.toggle-icon{color:var(--text-faint);font-weight:700;font-size:11px;transition:transform .18s ease}
details.http-block[open] > .http-title .toggle-icon{transform:rotate(180deg)}
.http-detail{
  padding:11px 13px;margin:0;font-family:var(--font-mono);font-size:11.5px;line-height:1.6;
  background:var(--surface-3);color:var(--text-2);white-space:pre-wrap;word-break:break-all;
  max-height:320px;overflow:auto;border-top:1px solid var(--border)
}
details:not([open]) > .http-detail{display:none}

/* replay */
.replay-section{margin:8px 0;padding:12px 14px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md)}
.replay-section h4{font-size:12.5px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.replay-curl{font-family:var(--font-mono);font-size:11.5px;background:#0B1220;color:#7EE2B8;padding:10px 12px;border-radius:8px;white-space:pre-wrap;word-break:break-all;margin:6px 0;border:1px solid #1E293B}
.replay-data-block{font-family:var(--font-mono);font-size:11.5px;background:var(--surface-3);padding:9px 11px;border-radius:8px;white-space:pre-wrap;word-break:break-all;max-height:220px;overflow:auto;border:1px solid var(--border);margin:4px 0}
.copy-btn{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;background:var(--surface);border:1px solid var(--border-strong);border-radius:8px;cursor:pointer;font-size:11px;font-family:var(--font-sans);font-weight:650;color:var(--text-2);transition:background .15s}
.copy-btn:hover{background:var(--surface-3)}
.copy-btn svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.copy-feedback{display:inline-block;font-size:11px;color:var(--sev-safe);margin-left:6px;opacity:0;transition:opacity .3s}
.copy-feedback.show{opacity:1}

/* warning / safe / info grids */
.warning-grid,.safe-grid,.info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:11px}
.warning-item,.safe-item,.info-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:13px 15px;border-left:4px solid var(--border-strong);box-shadow:var(--shadow-sm)}
.warning-item{border-left-color:var(--sev-warning)}
.safe-item{border-left-color:var(--sev-safe)}
.info-item{border-left-color:var(--sev-info)}
.warning-header,.safe-header,.info-header{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:5px}
.warning-name,.safe-name,.info-name{font-weight:700;font-size:13px}
.warning-conf{font-size:12px;font-weight:750;color:var(--text-muted)}
.warning-state{display:inline-block;padding:2px 9px;border-radius:99px;background:color-mix(in srgb,var(--sev-warning) 15%,var(--surface));color:var(--sev-warning);font-size:10px;font-weight:700}
.safe-badge{font-size:9.5px;padding:2px 9px;border-radius:99px;background:var(--sev-safe);color:#fff;text-transform:uppercase;font-weight:750;letter-spacing:.05em}
.warning-note,.safe-note,.info-note{font-size:12px;color:var(--text-2);line-height:1.5}
.safe-meta{display:flex;gap:11px;font-size:11px;color:var(--text-muted);margin-bottom:3px}
.safe-urls{font-size:10.5px;color:var(--text-faint);margin-top:4px;word-break:break-all}
.warning-verif{font-size:10.5px;color:var(--text-muted);margin-top:4px}

/* risk breakdown table */
.risk-breakdown{margin-top:8px}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--border);border-radius:var(--r-md)}
.breakdown-table{width:100%;border-collapse:collapse;border-spacing:0;font-size:12.5px;overflow:hidden}
.breakdown-table thead th{background:var(--surface-3);padding:9px 12px;text-align:left;font-weight:750;font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted);border-bottom:1px solid var(--border);white-space:nowrap}
.breakdown-table tbody td{padding:8px 12px;border-bottom:1px solid var(--border);color:var(--text-2)}
.breakdown-table tbody tr:last-child td{border-bottom:none}
.breakdown-table tbody tr:hover{background:var(--surface-2)}
.risk-explanation{margin-top:12px;padding:11px 14px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md)}
.risk-explanation h4{font-size:12px;font-weight:700;margin-bottom:5px;color:var(--text)}
.risk-explanation ul{margin:0 0 0 18px;font-size:12.5px;color:var(--text-2)}
.risk-explanation li{margin:3px 0}
.rb-formula{font-size:11.5px;color:var(--text-muted);margin:4px 0 10px}
.rb-total{font-size:12.5px;color:var(--text-2);margin:10px 0 0}
.rb-total strong{color:var(--text)}
.rb-total .msep{color:var(--text-faint);margin:0 8px}
.rb-risk{color:var(--accent);font-size:14px}
.rb-summary{font-size:12.5px;color:var(--text-2);margin-top:6px}
.coverage-skip-note .cs-item{font-size:11px;color:var(--text-2);margin-top:3px}
.scan-summary{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px 18px;margin-top:12px}

/* misc small sections */
.standardized-labels{display:flex;flex-wrap:wrap;gap:7px;align-items:center;padding:11px 14px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);margin-bottom:18px;font-size:11.5px}
.sl-title{font-weight:700;color:var(--text)}
.label-chip{background:var(--surface);border:1px solid var(--border);border-radius:99px;padding:3px 11px;color:var(--text-2);font-size:11px;font-weight:600}
.exec-state-summary{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:12px;font-size:12px}
.exec-state-summary span{background:var(--surface-3);border:1px solid var(--border);padding:3px 11px;border-radius:99px;color:var(--text-2);font-weight:600}
.coverage-explain{margin-top:8px;padding:8px 12px;background:color-mix(in srgb,var(--sev-safe) 8%,var(--surface));border:1px solid color-mix(in srgb,var(--sev-safe) 30%,var(--border));border-radius:var(--r-md);font-size:12px;color:var(--text-2)}
.coverage-skip-note{margin-top:8px;padding:8px 12px;background:color-mix(in srgb,var(--sev-warning) 9%,var(--surface));border:1px solid color-mix(in srgb,var(--sev-warning) 35%,var(--border));border-radius:var(--r-md);font-size:11.5px}
.payload-status{margin-top:10px;padding:10px 13px;background:color-mix(in srgb,var(--sev-warning) 9%,var(--surface));border:1px solid color-mix(in srgb,var(--sev-warning) 35%,var(--border));border-radius:var(--r-md);font-size:12px;display:flex;gap:9px;align-items:center}
.ps-badge{background:var(--sev-warning);color:#fff;padding:3px 11px;border-radius:99px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
.ps-reason{color:var(--text-2)}
.skip-details{margin-top:12px;padding:11px 14px;background:color-mix(in srgb,var(--sev-warning) 8%,var(--surface));border:1px solid color-mix(in srgb,var(--sev-warning) 30%,var(--border));border-radius:var(--r-md)}
.skip-details h4{font-size:12px;font-weight:700;margin-bottom:6px;color:var(--sev-warning)}
.skip-grid{display:grid;gap:5px}
.skip-item{display:flex;gap:10px;font-size:12.5px;padding:2px 2px}
.skip-reason{font-weight:650;min-width:170px;color:var(--text)}
.skip-modules{color:var(--text-muted)}
.sev-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:middle}
.sev-critical{background:var(--sev-critical)} .sev-high{background:var(--sev-high)} .sev-medium{background:var(--sev-medium)} .sev-low{background:var(--sev-low)} .sev-none{background:var(--sev-info)}

/* appendix / footer */
.footer{border-top:1px solid var(--border);margin-top:26px;padding:20px 0 4px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--text-muted)}
.footer .f-brand{font-weight:700;color:var(--text)}
.back-top{position:fixed;right:20px;bottom:20px;width:42px;height:42px;border-radius:12px;border:1px solid var(--border);background:var(--surface);color:var(--accent);box-shadow:var(--shadow-md);cursor:pointer;display:none;align-items:center;justify-content:center;z-index:40}
.back-top.show{display:inline-flex}
.back-top svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* ---------- responsive ---------- */
@media(max-width:640px){
  .page{padding:12px 10px 50px}
  .hero{padding:24px 20px 22px}
  .hero h1{font-size:23px}
  .hero-meta{grid-template-columns:repeat(2,1fr)}
  .kpi .k-value{font-size:22px}
  .panel{padding:17px 16px}
  .finding-card{padding:15px 15px 13px}
  .sev-cards{grid-template-columns:repeat(2,1fr)}
}

/* ---------- print ---------- */
@page{size:A4;margin:13mm 12mm}
@media print{
  body{background:#fff;font-size:11.5px;color:#111}
  .page{padding:0;max-width:none}
  .shell{grid-template-columns:1fr}
  .toc,.hbtn,.back-top{display:none!important}
  .hero{border-radius:0;box-shadow:none;padding:20px 0 16px;break-inside:avoid}
  .hero-meta{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}
  .panel{box-shadow:none;border:1px solid #dde3ec;break-inside:auto}
  .finding-card{box-shadow:none;break-inside:avoid}
  .sev-card,.as-item,.kpi,.em-item{break-inside:avoid}
  .dash-grid{grid-template-columns:1fr 1fr}
  details{--force-open:auto}
  details > summary{cursor:default}
  details > summary .toggle-icon{display:none}
  details > .http-detail,details > .http-detail,details.evidence-block > .http-detail{display:block!important;max-height:none}
  .http-block{break-inside:avoid}
  .replay-section{break-inside:avoid}
  .timeline{break-inside:avoid}
  a{color:inherit;text-decoration:none}
}
</style>
</head>
<body>
{% set crit = stats.get('critical', 0)|int %}
{% set high = stats.get('high', 0)|int %}
{% set medium = stats.get('medium', 0)|int %}
{% set low = stats.get('low', 0)|int %}
{% set warn = stats.get('warning', 0)|int %}
{% set info = stats.get('info', 0)|int %}
{% set safe = stats.get('safe', 0)|int %}
{% set tot_vulns = crit + high + medium + low %}
{% set tot_findings = crit + high + medium + low + warn + info + safe %}
{% set risk_int = risk|int %}
{% set cov = stats.get('coverage_percentage', 0)|int %}
{% set cov_ex = stats.get('coverage_executed', 0) %}
{% set cov_tot = stats.get('coverage_total', 0) %}
{% set crit_deg = ((crit * 360) // tot_vulns) if tot_vulns else 0 %}
{% set high_deg = ((high * 360) // tot_vulns) if tot_vulns else 0 %}
{% set med_deg  = ((medium * 360) // tot_vulns) if tot_vulns else 0 %}
{% set low_deg  = ((low * 360) // tot_vulns) if tot_vulns else 0 %}
{% set crit_end = crit_deg %}
{% set high_end = crit_end + high_deg %}
{% set med_end  = high_end + med_deg %}
{% set low_end  = med_end + low_deg %}
{% set r_deg = (risk_int * 360 // 100) %}
{% if risk_int >= 65 %}{% set gband = 'g-band-err' %}
{% elif risk_int >= 40 %}{% set gband = 'g-band-warn' %}
{% else %}{% set gband = 'g-band-ok' %}{% endif %}
{% if tot_vulns == 0 %}{% set gband = 'g-band-ok' %}{% endif %}

<div class="page" id="top">
  <!-- ================= COVER ================= -->
  <header class="hero">
    <div class="hero-top">
      <div class="hero-brand">
        {% if logo_url %}<img src="{{ logo_url }}" alt="Logo" class="hero-logo">{% endif %}
        <div>
          <div class="hero-badge">Confidential — Security Assessment</div>
          <h1>{{ company_name }}</h1>
          <div class="subtitle">Web Security Assessment Report</div>
        </div>
      </div>
      <div class="hero-actions">
        <button class="hbtn" id="themeToggle" type="button" title="Toggle light / dark theme">
          <svg id="themeIcon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
          <span id="themeLabel">Theme</span>
        </button>
        <button class="hbtn" type="button" onclick="window.print()" title="Print / Save as PDF">
          <svg viewBox="0 0 24 24"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
      </div>
    </div>
    <div class="hero-meta">
      <div class="hm-item"><div class="hm-k">Target</div><div class="hm-v">{{ target|e }}</div></div>
      {% if client_name %}<div class="hm-item"><div class="hm-k">Client</div><div class="hm-v">{{ client_name }}</div></div>{% endif %}
      {% if consultant_name %}<div class="hm-item"><div class="hm-k">Consultant</div><div class="hm-v">{{ consultant_name }}</div></div>{% endif %}
      {% if report_id %}<div class="hm-item"><div class="hm-k">Report ID</div><div class="hm-v">{{ report_id }}</div></div>{% endif %}
      <div class="hm-item"><div class="hm-k">Assessment Date</div><div class="hm-v">{{ current_date }}</div></div>
      <div class="hm-item"><div class="hm-k">Engine / Template</div><div class="hm-v">v{{ scanner_version }} <small>· template v{{ template_version }}</small></div></div>
      <div class="hm-item"><div class="hm-k">Overall Verdict</div><div class="hm-v">{{ overall_html }}</div></div>
    </div>
    <div class="hero-verdict">
      <span class="hv-dot" style="background: {{ overall_color }};"></span>
      <span class="hv-label">{{ overall_html }}</span>
      <span class="hv-desc">{{ overall_description }}</span>
    </div>
  </header>

  <!-- ================= BODY ================= -->
  <div class="shell">
    <nav class="toc" aria-label="Report contents">
      <div class="toc-title">Contents</div>
      <a href="#overview"><span class="toc-dot" style="background:var(--accent)"></span>Executive Overview</a>
      <a href="#risk"><span class="toc-dot" style="background:var(--accent-2)"></span>Risk Summary</a>
      <a href="#attack-surface"><span class="toc-dot" style="background:var(--text-faint)"></span>Attack Surface</a>
      {% if auth_html %}<a href="#auth"><span class="toc-dot" style="background:var(--text-faint)"></span>Authentication</a>{% endif %}
      {% if critical_html %}<a href="#critical-findings"><span class="toc-dot" style="background:var(--sev-critical)"></span>Critical<span class="toc-count">{{ crit }}</span></a>{% endif %}
      {% if high_html %}<a href="#high-findings"><span class="toc-dot" style="background:var(--sev-high)"></span>High<span class="toc-count">{{ high }}</span></a>{% endif %}
      {% if medium_html %}<a href="#medium-findings"><span class="toc-dot" style="background:var(--sev-medium)"></span>Medium<span class="toc-count">{{ medium }}</span></a>{% endif %}
      {% if low_html %}<a href="#low-findings"><span class="toc-dot" style="background:var(--sev-low)"></span>Low<span class="toc-count">{{ low }}</span></a>{% endif %}
      {% if warnings_html %}<a href="#warnings"><span class="toc-dot" style="background:var(--sev-warning)"></span>Warnings<span class="toc-count">{{ warn }}</span></a>{% endif %}
      {% if info_html %}<a href="#info"><span class="toc-dot" style="background:var(--sev-info)"></span>Information<span class="toc-count">{{ info }}</span></a>{% endif %}
      {% if safe_html %}<a href="#passed"><span class="toc-dot" style="background:var(--sev-safe)"></span>Passed Checks<span class="toc-count">{{ safe }}</span></a>{% endif %}
      {% if execution_states_html %}<a href="#execution"><span class="toc-dot" style="background:var(--text-faint)"></span>Execution States</a>{% endif %}
      <a href="#appendix"><span class="toc-dot" style="background:var(--text-faint)"></span>Appendix</a>
    </nav>

    <main class="main">

      <!-- ================= EXECUTIVE OVERVIEW ================= -->
      <section class="report-section" id="overview">
        {% if exec_summary %}
        <div class="panel">
          <h2><span class="p-ic"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>Executive Overview</h2>
          <div class="p-sub">A concise summary of the assessment outcome for decision makers.</div>
          {{ exec_summary }}
        </div>
        {% endif %}

        <div class="kpi-grid">
          <div class="kpi k-accent"><div class="k-label">Risk Score</div><div class="k-value">{{ risk_int }}<small style="font-size:15px">%</small></div><div class="k-foot">{{ overall_html }}</div></div>
          <div class="kpi k-crit"><div class="k-label">Critical</div><div class="k-value">{{ crit }}</div><div class="k-foot">Immediate action</div></div>
          <div class="kpi k-high"><div class="k-label">High</div><div class="k-value">{{ high }}</div><div class="k-foot">Urgent review</div></div>
          <div class="kpi k-medium"><div class="k-label">Medium</div><div class="k-value">{{ medium }}</div><div class="k-foot">Scheduled fix</div></div>
          <div class="kpi k-warning"><div class="k-label">Warnings</div><div class="k-value">{{ warn }}</div><div class="k-foot">Review required</div></div>
          <div class="kpi k-safe"><div class="k-label">Passed Checks</div><div class="k-value">{{ safe }}</div><div class="k-foot">No issue found</div></div>
          <div class="kpi k-info"><div class="k-label">Coverage</div><div class="k-value">{{ cov }}<small style="font-size:15px">%</small></div><div class="k-foot">{{ cov_ex }}/{{ cov_tot }} modules</div></div>
        </div>
      </section>

      <!-- ================= CHARTS ================= -->
      <section class="report-section" id="charts">
        <div class="dash-grid">
          <div class="chart-card">
            <div class="chart-title"><span class="c-kicker">Severity Distribution</span></div>
            <div class="chart-body">
              <div class="donut">
                <div class="donut-mask" style="background:conic-gradient(
                  {%- if tot_vulns > 0 %}
                  var(--sev-critical) 0deg {{ crit_end }}deg,
                  var(--sev-high) {{ crit_end }}deg {{ high_end }}deg,
                  var(--sev-medium) {{ high_end }}deg {{ med_end }}deg,
                  var(--sev-low) {{ med_end }}deg {{ low_end }}deg,
                  var(--chart-track) {{ low_end }}deg 360deg
                  {%- else %}
                  var(--chart-track) 0deg 360deg
                  {%- endif %});"></div>
                <div class="donut-center">
                  <span class="d-num">{{ tot_vulns }}</span>
                  <span class="d-cap">Findings</span>
                </div>
              </div>
              <div class="legend">
                <div class="legend-row"><span class="l-swatch" style="background:var(--sev-critical)"></span><span class="l-name">Critical</span><span class="l-val">{{ crit }}</span><span class="l-pct">{{ ((crit*100)//tot_vulns) if tot_vulns else 0 }}%</span></div>
                <div class="legend-row"><span class="l-swatch" style="background:var(--sev-high)"></span><span class="l-name">High</span><span class="l-val">{{ high }}</span><span class="l-pct">{{ ((high*100)//tot_vulns) if tot_vulns else 0 }}%</span></div>
                <div class="legend-row"><span class="l-swatch" style="background:var(--sev-medium)"></span><span class="l-name">Medium</span><span class="l-val">{{ medium }}</span><span class="l-pct">{{ ((medium*100)//tot_vulns) if tot_vulns else 0 }}%</span></div>
                <div class="legend-row"><span class="l-swatch" style="background:var(--sev-low)"></span><span class="l-name">Low</span><span class="l-val">{{ low }}</span><span class="l-pct">{{ ((low*100)//tot_vulns) if tot_vulns else 0 }}%</span></div>
                <div class="legend-row"><span class="l-swatch" style="background:var(--chart-track)"></span><span class="l-name">Warnings</span><span class="l-val">{{ warn }}</span><span class="l-pct">{{ ((warn*100)//tot_findings) if tot_findings else 0 }}%</span></div>
              </div>
            </div>
          </div>
          <div class="chart-card">
            <div class="chart-title"><span class="c-kicker">Risk Score</span></div>
            <div class="chart-body">
              <div class="gauge {{ gband }}">
                <div class="gauge-mask" style="background:conic-gradient(var(--gauge-color) 0deg {{ r_deg }}deg, var(--chart-track) {{ r_deg }}deg 360deg);"></div>
                <div class="gauge-center"><span class="g-num">{{ risk_int }}</span><span class="g-cap">/ 100</span></div>
              </div>
              <div class="gauge-side">
                <div class="gs-row"><span>Overall Severity</span><b>{{ overall_html }}</b></div>
                <div class="gs-row"><span>Vulnerabilities</span><b>{{ tot_vulns }}</b></div>
                <div class="gs-row"><span>Warnings</span><b>{{ warn }}</b></div>
                <div class="gs-row"><span>Verified findings</span><b>{{ stats.get('verified_vulns', 0) }}</b></div>
                <div class="gs-row"><span>Coverage</span><b>{{ cov }}%</b></div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel" style="margin-top:22px">
          <h2><span class="p-ic"><svg viewBox="0 0 24 24"><path d="M3 12h18M12 3v18M3 3l18 18"/></svg></span>Coverage and Findings Distribution</h2>
          <div class="coverage-section">
            <div class="coverage-head">
              <span class="title">Module Coverage</span>
              <span class="percentage">{{ cov }}%</span>
            </div>
            <div class="coverage-track"><div class="coverage-fill" style="width:{{ cov }}%"></div></div>
            <div class="coverage-footer">
              <span>{{ cov_ex }} / {{ cov_tot }} modules executed</span>
              <span>{{ stats.get('coverage_skipped', 0) }} skipped</span>
              <span>{{ stats.get('coverage_failed', 0) }} failed</span>
              <span>{{ stats.get('coverage_not_applicable', 0) }} N/A</span>
            </div>
          </div>
          {% if tot_findings > 0 %}
          <div style="margin-top:14px">
            <div class="p-sub" style="margin-bottom:2px">Findings by severity — share of all findings</div>
            <div class="sev-stack">
              {% if crit > 0 %}<div style="flex:{{ crit }};background:var(--sev-critical)" title="{{ crit }} critical"></div>{% endif %}
              {% if high > 0 %}<div style="flex:{{ high }};background:var(--sev-high)" title="{{ high }} high"></div>{% endif %}
              {% if medium > 0 %}<div style="flex:{{ medium }};background:var(--sev-medium)" title="{{ medium }} medium"></div>{% endif %}
              {% if low > 0 %}<div style="flex:{{ low }};background:var(--sev-low)" title="{{ low }} low"></div>{% endif %}
              {% if warn > 0 %}<div style="flex:{{ warn }};background:var(--sev-warning)" title="{{ warn }} warnings"></div>{% endif %}
              {% if info > 0 %}<div style="flex:{{ info }};background:var(--sev-info)" title="{{ info }} info"></div>{% endif %}
              {% if safe > 0 %}<div style="flex:{{ safe }};background:var(--sev-safe)" title="{{ safe }} passed"></div>{% endif %}
            </div>
          </div>
          {% endif %}
          {{ coverage_explanation_html }}
          {{ skip_reasons_coverage }}
          {{ payload_html }}
        </div>
      </section>

      <!-- ================= RISK SUMMARY ================= -->
      <section class="report-section" id="risk">
        <div class="panel">
          <h2><span class="p-ic"><svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg></span>Risk Summary</h2>
          <div class="p-sub">Transparent weighted risk scoring — every factor is visible and auditable.</div>
          <div class="risk-meter">
            <div class="risk-score-row">
              <div class="risk-score-big">
                <div class="rs-num">{{ risk_int }}<span style="font-size:22px">%</span></div>
                <div class="rs-sub">Weighted Risk Score</div>
              </div>
              <div style="flex:1;min-width:240px">
                <div class="meter">
                  <div class="meter-track"></div>
                  <div class="meter-fill" style="left:{{ risk_int }}%"></div>
                </div>
                <div class="meter-labels"><span>0 · No Risk</span><span>40 · Elevated</span><span>65 · High</span><span>100 · Critical</span></div>
              </div>
              <div class="risk-score-big" style="text-align:right">
                <div class="rs-num" style="color:{{ overall_color }}">{{ overall_html }}</div>
                <div class="rs-sub">Overall Severity</div>
              </div>
            </div>
            {% if overall_description %}<div class="risk-note"><strong>Assessment note:</strong> {{ overall_description }}</div>{% endif %}
            {{ risk_breakdown }}
          </div>
        </div>
      </section>

      <!-- ================= ATTACK SURFACE ================= -->
      <section class="report-section" id="attack-surface">
        {% if attack_surface %}
        <div class="panel">
          <h2><span class="p-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg></span>Attack Surface Summary</h2>
          <div class="p-sub">Discovery scope and modules exercised during the assessment.</div>
          {{ attack_surface }}
        </div>
        {% endif %}
      </section>

      <!-- ================= AUTHENTICATION ================= -->
      {% if auth_html %}
      <section class="report-section" id="auth">
        {{ auth_html }}
      </section>
      {% endif %}

      <!-- ================= FINDINGS ================= -->
      {% if critical_html %}
      <section class="report-section" id="critical-findings">
        {{ critical_html }}
      </section>
      {% endif %}
      {% if high_html %}
      <section class="report-section" id="high-findings">
        {{ high_html }}
      </section>
      {% endif %}
      {% if medium_html %}
      <section class="report-section" id="medium-findings">
        {{ medium_html }}
      </section>
      {% endif %}
      {% if low_html %}
      <section class="report-section" id="low-findings">
        {{ low_html }}
      </section>
      {% endif %}
      {% if warnings_html %}
      <section class="report-section" id="warnings">
        {{ warnings_html }}
      </section>
      {% endif %}
      {% if info_html %}
      <section class="report-section" id="info">
        {{ info_html }}
      </section>
      {% endif %}
      {% if safe_html %}
      <section class="report-section" id="passed">
        {{ safe_html }}
      </section>
      {% endif %}

      <!-- ================= EXECUTION STATES ================= -->
      {% if execution_states_html %}
      <section class="report-section" id="execution">
        <div class="panel">
          <h2><span class="p-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>Module Execution States</h2>
          {{ execution_states_html }}
        </div>
      </section>
      {% endif %}

      <!-- ================= APPENDIX ================= -->
      <section class="report-section" id="appendix">
        <div class="panel">
          <h2><span class="p-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg></span>Appendix</h2>
          <div class="p-sub">Report metadata and standardized verification vocabulary.</div>
          {{ standardized_labels_html }}
          <div class="scan-summary">
            <h3 style="font-size:14px;font-weight:700;margin-bottom:12px">Scan Summary</h3>
            <div class="kpi-grid">
              <div class="kpi k-accent"><div class="k-label">Scanner Engine</div><div class="k-value" style="font-size:19px">v{{ engine_version }}</div></div>
              <div class="kpi k-accent"><div class="k-label">Detection Rules</div><div class="k-value" style="font-size:19px">v{{ detection_rules_version }}</div></div>
              <div class="kpi k-accent"><div class="k-label">Report Template</div><div class="k-value" style="font-size:19px">v{{ template_version }}</div></div>
              <div class="kpi k-info"><div class="k-label">HTTP Requests</div><div class="k-value" style="font-size:19px">{{ stats.get('requests_sent', 0) }}</div></div>
              <div class="kpi k-info"><div class="k-label">Payloads Executed</div><div class="k-value" style="font-size:19px">{{ payload_display }}</div></div>
              <div class="kpi k-info"><div class="k-label">Headers Tests</div><div class="k-value" style="font-size:19px">{{ stats.get('headers_tests', 0) }}</div></div>
              <div class="kpi k-info"><div class="k-label">Port Tests</div><div class="k-value" style="font-size:19px">{{ stats.get('port_tests', 0) }}</div></div>
              <div class="kpi k-info"><div class="k-label">Duration</div><div class="k-value" style="font-size:19px">{{ "%.1f"|format(stats.get('duration', 0)) }}s</div></div>
            </div>
          </div>
        </div>
      </section>

      <footer class="footer">
        <span><span class="f-brand">{{ company_name }}</span> · Security Assessment Report</span>
        <span>Generated {{ current_date }}{% if report_id %} · Report ID: {{ report_id }}{% endif %}</span>
        <span>Engine v{{ scanner_version }} · Template v{{ template_version }}</span>
      </footer>
    </main>
  </div>
</div>

<button class="back-top" id="backTop" type="button" aria-label="Back to top">
  <svg viewBox="0 0 24 24"><path d="m18 15-6-6-6 6"/></svg>
</button>

<script>
(function(){
  "use strict";
  // ---- theme ----
  var root = document.documentElement;
  function applyTheme(t){
    root.setAttribute("data-theme", t);
    var icon = document.getElementById("themeIcon");
    var label = document.getElementById("themeLabel");
    if (!icon || !label) return;
    if (t === "dark"){
      icon.innerHTML = '<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/>';
      label.textContent = "Dark";
    } else {
      icon.innerHTML = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/>';
      label.textContent = "Light";
    }
  }
  var stored = null;
  try { stored = localStorage.getItem("sea-theme"); } catch(e){}
  if (stored === "light" || stored === "dark") applyTheme(stored);
  var btn = document.getElementById("themeToggle");
  if (btn){
    btn.addEventListener("click", function(){
      var cur = root.getAttribute("data-theme");
      var next = (cur === "dark") ? "light" : "dark";
      applyTheme(next);
      try { localStorage.setItem("sea-theme", next); } catch(e){}
    });
  }

  // ---- back to top ----
  var bt = document.getElementById("backTop");
  if (bt){
    window.addEventListener("scroll", function(){
      if (window.scrollY > 600) bt.classList.add("show");
      else bt.classList.remove("show");
    });
    bt.addEventListener("click", function(){ window.scrollTo({top:0, behavior:"smooth"}); });
  }

  // ---- copy buttons (progressive enhancement) ----
  function fallbackCopy(text, btn){
    var ta = document.createElement("textarea");
    ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
    document.body.appendChild(ta); ta.select();
    try { document.execCommand("copy"); showFeedback(btn); } catch(e){}
    document.body.removeChild(ta);
  }
  function showFeedback(btn){
    var fb = btn ? btn.nextElementSibling : null;
    if (fb){
      if (fb.classList){
        fb.classList.add("show");
        setTimeout(function(){ fb.classList.remove("show"); }, 1500);
      }
    }
  }
  window.copyReplay = function(btn){
    var parent = btn.closest(".replay-section");
    var curl = parent ? parent.querySelector(".replay-curl") : null;
    if (!curl) return;
    var text = curl.textContent.trim();
    if (!text) return;
    if (navigator.clipboard){
      if (navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(function(){ showFeedback(btn); })
          .catch(function(){ fallbackCopy(text, btn); });
        return;
      }
    }
    fallbackCopy(text, btn);
  };
})();
</script>
</body>
</html>
